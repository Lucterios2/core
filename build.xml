<project name="Lucterios2" default="all" basedir=".">
	<property name="standard.path"
		value="${basedir}/../lct-standard" />
	<property name="project.packagepath"
		value="lucterios/CORE,lucterios/framework,lucterios/install" />
	<property name="project.packagename"
		value="lucterios.CORE lucterios.dummy" />
	<property name="project.name" value="lucterios" />
	<property name="project.pythonpath" value="${standard.path}:${env.PYTHONPATH}" />
	<property name="project.packname" value="lucterios.egg-info" />
	<property name="project.modules" value="lucterios.dummy" />
	<property name="project.appli" value="lucterios.standard" />
	<property name="project.radon.exclude" value="lct-core/client/**/*.py" />
    <property name="client.path" value="lucterios/framework/static/lucterios.framework/web" />
	<import file="${basedir}/utils/lib_build.xml" />

	<target name="clientweb">
		<antcall target="clear_addon" />
		<antcall target="init_addon" />
	</target>

	<target name="clear_addon">
        <delete dir="${client.path}" />
        <mkdir dir="${client.path}" />
	</target>

	<target name="init_addon">
        <antcall target="download_newclient" />
        <antcall target="extract_mdiclient" />
	</target>

	<target name="download_newclient">
	    <delete file="/tmp/client_artifacts.zip" />
        <get src="https://gitlab.sleto.fr/api/v4/projects/38/jobs/artifacts/master/download?job=build" dest="/tmp/client_artifacts.zip">
          <header name="PRIVATE-TOKEN" value="${env.GITLAB_TOKEN}"/>
        </get>
        <delete dir="/tmp/client_artifacts" />
        <mkdir dir="/tmp/client_artifacts" />
        <unzip src="/tmp/client_artifacts.zip" dest="/tmp/client_artifacts" />
        <move todir="${client.path}">
            <fileset dir="/tmp/client_artifacts/dist"/>
        </move>
        <loadfile property="client_version_expected" srcFile="client/build_client"/>
        <echo>======= Expected client version: ${client_version_expected}</echo>
        <loadfile property="newclient_version" srcFile="${client.path}/conf/build"/>
        <echo>======= Download client version: ${newclient_version}</echo>
	</target>
	
	<target name="extract_mdiclient">
        <delete dir="lucterios/framework/mdi-icons" />
        <mkdir dir="lucterios/framework/mdi-icons" />
        <fileset dir="${basedir}/lucterios/framework/static/lucterios.framework/web/assets/" id="mdifont">
            <include name="materialdesignicons-webfont-*.ttf"/>
        </fileset>
        <echo message="mdifond=${ant.refid:mdifont}"/>
	    <exec executable="fonts2svg" dir="${basedir}">
	       <arg value="-c" />
	       <arg value="000000" />
	       <arg value="-o" />
	       <arg value="lucterios/framework/mdi-icons" />
	       <arg value="${basedir}/lucterios/framework/static/lucterios.framework/web/assets/${ant.refid:mdifont}" />
	    </exec>
	</target>

	<target name="test_admin">
		<exec executable="${project.pythonexe}" dir="${basedir}">
			<arg value="-m" />
			<arg value="pip" />
			<arg value="install" />
			<arg value="-U" />
			<arg value="lucterios_standard" />
		</exec>
		<exec executable="${project.pythonexe}" dir="${basedir}">
			<env key="PYTHONPATH" value="${basedir}:${project.pythonpath}" />
			<arg value="-m" />
			<arg value="coverage" />
			<arg value="run" />
			<arg value="--append" />
			<arg value="--branch" />
			<arg value="--source=lucterios" />
			<arg
				value="--omit=*/install/lucterios_gui.py,*/install/lucterios_qt.py,*/install/graphic_lib.py" />
			<arg value="lucterios/install/admin_test.py" />
		</exec>
		<replace file="${basedir}/results.xml" token="__main__." value="lucterios-py3.TestAdmin." />
		<move file="${basedir}/results.xml" tofile="junit_admin_py3.xml" />
	</target>

	<target name="test_addon">
		<antcall target="test_admin" />
	</target>


</project>
