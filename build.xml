<project name="Lucterios2" default="all" basedir=".">
	<property name="standard.path" value="${basedir}/../lct-standard" />
	<property name="project.packagepath" value="lucterios/CORE,lucterios/framework,lucterios/install" />
	<property name="project.packagename" value="lucterios.CORE lucterios.dummy" />
	<property name="project.name" value="lucterios" />
	<property name="project.pythonpath" value="${standard.path}:${env.PYTHONPATH}" />
	<property name="project.packname" value="lucterios.egg-info" />
	<property name="project.modules" value="lucterios.dummy" />
	<property name="project.appli" value="lucterios.standard" />
	<property name="project.radon.exclude" value="lct-core/client/**/*.py" />
	<property name="web.root" value="${basedir}/client" />
	<property name="web.client" value="${web.root}/static" />
	<property name="web.browser" value="client/platforms/browser/www/" />
	<property name="web.path" value="lucterios/framework/static/lucterios.framework/web" />
	<property name="web.version" value="1.5.0" />
	<import file="${basedir}/utils/lib_build.xml" />

	<target name="clear_addon">
		<mkdir dir="${web.path}" />
		<delete dir="${web.path}" />
		<exec executable="cordova" dir="${basedir}/client" failonerror="true">
			<arg value="clean" />
		</exec>
		<delete dir="${basedir}/client/platforms/electron/build" />
		<delete dir="${web.root}/node_modules" />
	</target>

	<target name="init_addon">
		<mkdir dir="${web.client}/conf" />
		<echo message="${web.version}.${build_number}" file="${web.client}/conf/build" append="false" />
		<replaceregexp file="${web.root}/config.xml" match='version="[0-9\.]+"' replace='version="${web.version}"' byline="true" />	
		<replaceregexp file="${web.root}/package.json" match='"version": "[0-9\.]+",' replace='"version": "${web.version}",' byline="true" />	
		<exec executable="npm" dir="${web.root}" failonerror="true">
			<arg value="install" />
		</exec>
		<exec executable="npm" dir="${web.root}" failonerror="true">
			<arg value="run" />
			<arg value="lint" />
		</exec>
	</target>

	<target name="package_addon">
		<exec executable="npm" dir="${web.root}" failonerror="true">
			<arg value="run" />
			<arg value="build" />
		</exec>
		<exec executable="cordova" dir="${web.root}" failonerror="true">
			<arg value="build" />
			<arg value="browser" />
		</exec>
		<replace file="${web.browser}/index.html" token='src=../../js/' value='src=js/' />
		<copy todir="${web.path}">
		  <fileset dir="${web.browser}"/>
		</copy>
	</target>

	<target name="test_addon">
		<exec executable="npm" dir="${web.root}" failonerror="true">
			<arg value="run" />
			<arg value="unit" />
		</exec>
		<exec executable="${project.pythonexe}" dir="${basedir}">
			<arg value="${web.root}/test/lcov_cobertura.py" />		
			<arg value="${web.root}/test/coverage/lcov.info" />
			<arg value="--base-dir" />
			<arg value="${web.root}/src" />
			<arg value="--output" />
			<arg value="coverage_jsweb.xml" />
		</exec>
		<exec executable="${project.pythonexe}" dir="${basedir}">
			<env key="PYTHONPATH" value="${basedir}:${project.pythonpath}" />
			<arg value="/usr/local/bin/coverage" />
			<arg value="run" />
			<arg value="--append" />
			<arg value="--branch" />
			<arg value="--source=lucterios" />
			<arg value="--omit=lucterios/install/lucterios_gui.py" />
			<arg value="lucterios/install/admin_test.py" />
		</exec>
		<replace file="${basedir}/results.xml" token="__main__." value="lucterios-py3.TestAdmin." />
		<move file="${basedir}/results.xml" tofile="junit_admin_py3.xml" />
	</target>

</project>
